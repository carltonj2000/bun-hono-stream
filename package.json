{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:client": "bun build ./src/client/index.html --outdir ./dist --watch",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\""
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "bun-plugin-tailwind": "^0.1.2",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
